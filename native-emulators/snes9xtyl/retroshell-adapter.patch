+#ifdef RETROSHELL_ADAPTER
+////////////////////////////////////////////////////////////////////////////////////////
+// RetroShell pause surface (native adapter protocol v1)
+//
+// Drawn with Snes9xTYL's resident pg primitives so the emulator keeps all of
+// its gameplay memory. The rows follow RetroShell's shared order
+// (rs_pause_menu.h); only Emulator Settings enters Snes9xTYL's own menu.
+////////////////////////////////////////////////////////////////////////////////////////
+extern "C" int state_slot;
+extern "C" int root_menu(void);
+
+#define RS_COL(r,g,b)    ((r)|((g)<<5)|((b)<<10)|0x8000)
+#define RS_MENU_BG       RS_COL( 2,  2,  3)
+#define RS_MENU_PANEL    RS_COL( 5,  5,  6)
+#define RS_MENU_FOCUS    RS_COL( 9,  9, 10)
+#define RS_MENU_ACCENT   RS_COL(31, 12,  2)
+#define RS_MENU_TEXT     RS_COL(29, 28, 26)
+#define RS_MENU_TEXT_DIM RS_COL(19, 18, 17)
+#define RS_MENU_OFF      RS_COL(11, 11, 11)
+#define RS_SLOTS 10
+
+static const char *const rs_aspect_names[6] = {
+	"1:1", "Fit", "4:3", "Wide", "Full", "Full (clipped)"};
+
+static void rs_state_ext(char *ext, int slot) {
+	strcpy(ext, ".za0");
+	ext[3] = '0' + slot;
+}
+
+static void rs_draw_pause(int row, int slot, int occupied, const char *stamp) {
+	char line[64];
+	int i;
+
+	pgFillBox(0, 0, 479, 271, RS_MENU_BG);
+	pgFillBox(16, 24, 280, 232, RS_MENU_PANEL);
+	pgDrawFrame(16, 24, 280, 232, RS_MENU_TEXT_DIM);
+	snprintf(line, sizeof(line), "%.38s", Memory.ROMName);
+	mh_print(32, 32, line, RS_MENU_TEXT_DIM);
+
+	for (i = 0; i < RS_PAUSE_ITEM_COUNT; i++) {
+		const int y = 52 + i * 19;
+		const char *label = rs_pause_menu_label((RSPauseMenuItem)i);
+		int col = (i == row) ? RS_MENU_TEXT : RS_MENU_TEXT_DIM;
+		switch (i) {
+			case RS_PAUSE_SAVE_STATE:
+			case RS_PAUSE_LOAD_STATE:
+				snprintf(line, sizeof(line), "%s  < Slot %d >", label, slot + 1);
+				if (i == RS_PAUSE_LOAD_STATE && !occupied) col = RS_MENU_OFF;
+				break;
+			case RS_PAUSE_ASPECT_RATIO:
+				snprintf(line, sizeof(line), "%s  < %s >", label,
+				         rs_aspect_names[os9x_render % 6]);
+				break;
+			case RS_PAUSE_FILTER:
+				snprintf(line, sizeof(line), "%s  < %s >", label,
+				         os9x_smoothing ? "Smooth" : "Sharp");
+				break;
+			default:
+				snprintf(line, sizeof(line), "%s", label);
+				break;
+		}
+		if (i == row) {
+			pgFillBox(24, y - 4, 272, y + 13, RS_MENU_FOCUS);
+			pgDrawFrame(24, y - 4, 272, y + 13, RS_MENU_ACCENT);
+		}
+		mh_print(32, y, line, col);
+	}
+
+	/* The focused slot's preview beside the panel. */
+	if (row == RS_PAUSE_SAVE_STATE || row == RS_PAUSE_LOAD_STATE) {
+		snprintf(line, sizeof(line), "SLOT %d", slot + 1);
+		mh_print(300, 32, line, RS_MENU_TEXT_DIM);
+		if (occupied) {
+			int y;
+			for (y = 0; y < 120; y++)
+				memcpy(pgGetVramAddr(300, 48 + y), &os9x_savestate_mini[y * 128],
+				       128 * 2);
+			pgDrawFrame(299, 47, 428, 168, RS_MENU_TEXT_DIM);
+			mh_print(300, 176, stamp, RS_MENU_TEXT_DIM);
+		} else {
+			mh_print(300, 52, "Empty", RS_MENU_TEXT_DIM);
+		}
+	}
+
+	pgFillBox(0, 240, 479, 271, RS_MENU_PANEL);
+	mh_print(200, 252, "<>  Change", RS_MENU_TEXT_DIM);
+	mh_print(296, 252, "X  Select", RS_MENU_TEXT);
+	mh_print(392, 252, "O  Resume", RS_MENU_TEXT_DIM);
+}
+
+/* Called from S9xProcessEvents between before_pause() and after_pause().
+ * Returns once the game should resume or the emulator is exiting. */
+static int retroshell_pause_menu() {
+	char ext[8];
+	char stamp[32] = "";
+	int row = RS_PAUSE_RESUME;
+	int slot = (state_slot >= 0 && state_slot < RS_SLOTS) ? state_slot : 0;
+	int occupied, shown_slot = -1;
+	unsigned int old_pad, pad, pressed;
+
+	rs_pause_pending = 0;
+	rs_adapter_record(&retroshell_adapter, RS_ADAPTER_PAUSED);
+	while (get_pad()) pgWaitV();
+	old_pad = 0;
+	occupied = 0;
+
+	for (;;) {
+		if (slot != shown_slot) {
+			rs_state_ext(ext, slot);
+			occupied = os9x_getstate(ext, stamp);
+			shown_slot = slot;
+		}
+		rs_draw_pause(row, slot, occupied, stamp);
+		pgWaitV();
+		pgScreenFlipV2();
+
+		pad = get_pad();
+		pressed = pad & ~old_pad;
+		old_pad = pad;
+		if (!g_bLoop) break;
+
+		if (pressed & PSP_CTRL_UP) row = (row + RS_PAUSE_ITEM_COUNT - 1) % RS_PAUSE_ITEM_COUNT;
+		if (pressed & PSP_CTRL_DOWN) row = (row + 1) % RS_PAUSE_ITEM_COUNT;
+		if (pressed & (PSP_CTRL_LEFT | PSP_CTRL_RIGHT)) {
+			const int dir = (pressed & PSP_CTRL_LEFT) ? -1 : 1;
+			if (row == RS_PAUSE_SAVE_STATE || row == RS_PAUSE_LOAD_STATE) {
+				slot = (slot + dir + RS_SLOTS) % RS_SLOTS;
+				state_slot = slot;
+			} else if (row == RS_PAUSE_ASPECT_RATIO) {
+				os9x_render = (os9x_render + dir + 6) % 6;
+				menu_modified = 1;
+			} else if (row == RS_PAUSE_FILTER) {
+				os9x_smoothing = !os9x_smoothing;
+				menu_modified = 1;
+			}
+		}
+		if (pressed & PSP_CTRL_CIRCLE) break;
+		if (!(pressed & PSP_CTRL_CROSS)) continue;
+
+		if (row == RS_PAUSE_RESUME) break;
+		if (row == RS_PAUSE_SAVE_STATE) {
+			rs_state_ext(ext, slot);
+			msgBoxLines(s9xTYL_msg[MENU_STATE_ISSAVING], 10);
+			os9x_save(ext);
+			break;
+		}
+		if (row == RS_PAUSE_LOAD_STATE) {
+			if (!occupied) continue;
+			rs_state_ext(ext, slot);
+			msgBoxLines(s9xTYL_msg[MENU_STATE_ISLOADING], 10);
+			os9x_load(ext);
+			break;
+		}
+		if (row == RS_PAUSE_RESET) {
+			if (!os9x_lowbat) os9x_savesram();
+			S9xReset();
+			rs_adapter_record(&retroshell_adapter, RS_ADAPTER_RESET);
+			break;
+		}
+		if (row == RS_PAUSE_ASPECT_RATIO) {
+			os9x_render = (os9x_render + 1) % 6;
+			menu_modified = 1;
+		} else if (row == RS_PAUSE_FILTER) {
+			os9x_smoothing = !os9x_smoothing;
+			menu_modified = 1;
+		} else if (row == RS_PAUSE_SCREENSHOT) {
+			msgBoxLines(s9xTYL_msg[MENU_MISC_SAVINGJPEG], 10);
+			if (!os9x_lowbat) os9x_savesnap();
+			break;
+		} else if (row == RS_PAUSE_EMULATOR_SETTINGS) {
+			/* Snes9xTYL's original menu; back here when it closes. Its 3D
+			 * background reconfigures the GE (depth buffer, viewport,
+			 * clip planes, face order, lighting) and its fx_close() runs
+			 * outside a display list, so part of that outlives the menu
+			 * and after_pause()'s blit_reinit() does not cover it. Put
+			 * every GE register back exactly as the game left it. */
+			static PspGeContext ge_context __attribute__((aligned(16)));
+			sceGuSync(0, 0);
+			const int saved = sceGeSaveContext(&ge_context);
+			root_menu();
+			sceGuSync(0, 0);
+			if (saved >= 0) sceGeRestoreContext(&ge_context);
+			if (!g_bLoop || os9x_getnewfile) break;
+			while (get_pad()) pgWaitV();
+			old_pad = 0;
+			shown_slot = -1;
+		} else if (row == RS_PAUSE_EXIT) {
+			S9xExit();
+			break;
+		}
+	}
