+const char *S9xGetLoadFilename( const char *e ) {
+	const char *name = S9xGetSaveFilename(e);
+#ifdef RETROSHELL_ADAPTER
+	static char legacy[_MAX_PATH + 1];
+	SceIoStat stat;
+	if (retroshell_adapter.active && retroshell_adapter.save_directory[0] &&
+	    sceIoGetstat(name, &stat) < 0) {
+		build_save_filename(legacy, SaveDir, e);
+		if (sceIoGetstat(legacy, &stat) >= 0) return legacy;
+	}
+#endif
+	return name;
+}
