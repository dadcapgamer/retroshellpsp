+const char *S9xGetSaveFilename( const char *e ) {
+	static char filename[_MAX_PATH + 1];
+	const char *dir = SaveDir;
+#ifdef RETROSHELL_ADAPTER
+	/* Under RetroShell, battery saves go to the game's shared folder and
+	 * everything Snes9xTYL-specific (states, previews, cheats) beneath
