diff --git a/source/src/main.c b/source/src/main.c
--- a/source/src/main.c
+++ b/source/src/main.c
@@ -840,5 +840,32 @@ int user_main(int argc, char *argv[])
   // Initialize overlay cache at boot
   init_overlays_at_boot();
+
+  /* RetroShell owns the presentation choice for adapter launches. Select the
+   * bundled GBA border by name so user-added overlays cannot change its slot,
+   * and top-align FrogGBA's native 1.5x viewport with that artwork. The native
+   * overlay menu remains available for changing or disabling it in-session. */
+  if (retroshell_adapter.active)
+  {
+    extern char overlay_names[][64];
+    extern u32 num_overlays;
+    extern void set_gba_resolution(void);
+    u32 overlay_index;
+
+    for (overlay_index = 1; overlay_index < num_overlays; overlay_index++)
+    {
+      if (strcmp(overlay_names[overlay_index], "Watomsk-GBA") == 0)
+      {
+        option_overlay_enabled = 1;
+        option_overlay_selected = overlay_index;
+        option_overlay_offset_x = 120;
+        option_overlay_offset_y = 40;
+        option_screen_scale = SCALED_X15_GU;
+        option_aspect_ratio = 0;
+        set_gba_resolution();
+        break;
+      }
+    }
+  }
   
   // Initialize recent games tracking
   extern void load_recent_games(void);
