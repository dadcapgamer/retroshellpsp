diff --git a/source/src/input.c b/source/src/input.c
index 6674e15..f34cdcb 100644
--- a/source/src/input.c
+++ b/source/src/input.c
@@ -324,4 +324,21 @@ u32 update_input(void)
   non_repeat_buttons = (last_buttons ^ buttons) & buttons;
   last_buttons = buttons;
 
+  /* Check this before FrogGBA's SELECT+R fast-forward shortcut. */
+  if (rs_adapter_pause_requested(buttons, non_repeat_buttons))
+  {
+    u32 menu_result;
+    SceCtrlData ctrl_wait;
+    rs_adapter_record(&retroshell_adapter, RS_ADAPTER_PAUSED);
+    menu_result = menu();
+    do {
+      sceCtrlReadBufferPositive(&ctrl_wait, 1);
+      sceKernelDelayThread(16000);
+    } while ((ctrl_wait.Buttons &
+              (PSP_CTRL_LTRIGGER | PSP_CTRL_RTRIGGER | PSP_CTRL_SELECT)) != 0);
+    last_buttons = 0;
+    rs_adapter_record(&retroshell_adapter, RS_ADAPTER_RESUMED);
+    return menu_result;
+  }
+
   // Check for SELECT + R combination to toggle fast forward speed
